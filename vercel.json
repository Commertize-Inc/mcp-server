{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"installCommand": "npm ci",
	"buildCommand": "npm run build",
	"outputDirectory": "public",
	"functions": {
		"api/*.js": {
			"includeFiles": "content/**",
			"maxDuration": 30
		}
	},
	"rewrites": [
		{ "source": "/mcp", "destination": "/api/mcp" },
		{ "source": "/mcp/public", "destination": "/api/mcp-public" },
		{ "source": "/openapi.json", "destination": "/api/openapi" },
		{ "source": "/.well-known/agent-card.json", "destination": "/api/agent-card?p=card" },
		{ "source": "/.well-known/agent.json", "destination": "/api/agent-card?p=legacy" },
		{ "source": "/health", "destination": "/api/health" }
	],
	"headers": [
		{
			"source": "/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "no-store" },
				{ "key": "X-Content-Type-Options", "value": "nosniff" },
				{ "key": "X-Robots-Tag", "value": "noindex" }
			]
		}
	]
}
